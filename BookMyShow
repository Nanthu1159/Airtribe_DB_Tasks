—--------------

Create table MovieDetails(MovieId int AUTO_INCREMENT Primary key, MovieName varchar(50) NOT NULL, 
SensorType varchar (10), Genre varchar(30), Duration int, ReleaseDate date, Description text, 
cast text(255));

desc MovieDetails;

Create table TheatreDetails(ThreatreId int AUTO_INCREMENT Primary key, ThreatreName varchar(50) NOT NULL,
Address varchar(100), State varchar(50), City varchar(50), ZipCode int);

desc TheatreDetails;

Create table ScreenDetails(ScreenId int AUTO_INCREMENT Primary key, TheatreId int NOT NULL, 
ScreenNumber int, ScreenName varchar(50), TotalSeats int);

desc ScreenDetails;

Create table ShowDetails(ShowId int AUTO_INCREMENT Primary key, ScreenId int NOT NULL, 
MovieId int NOT NULL, ShowTime Time NOT NULL, ShowDate Date NOT NULL, MovieFormat char(10) default '2D', 
Language varchar(20));

desc ShowDetails;

Create table SeatDetails(SeatId int AUTO_INCREMENT Primary key, ScreenId int NOT NULL, SeatingType char(25), 
RowNumber char, SeatNumber tinyInt, IsOccupied Boolean);

desc SeatDetails;

Create table UserDetails(UserId int AUTO_INCREMENT Primary key, UserName varchar(50), Email varchar(50) Unique,
PhoneNumber int);

desc UserDetails;

Create table BookingDetails(BookingId int AUTO_INCREMENT Primary key, ShowId int NOT NULL, UserId int NOT NULL,
Total_Cost int, PaymentMethod varchar(50), BookedTime timestamp default current_timestamp);

desc BookingDetails;

Create table TicketDetails(TicketId int AUTO_INCREMENT Primary key, BookingId int NOT NULL, 
SeatId int NOT NULL, ShowId int NOT NULL, Cost int);

desc TicketDetails;


